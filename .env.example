# Public mobile configuration only. Never put Gemini/Chapa secrets or Supabase service-role keys here.
EXPO_PUBLIC_BUNALENS_SYNC_URL=
EXPO_PUBLIC_CERTIFICATE_VERIFY_BASE_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_CHAPA_INITIALIZE_URL=
